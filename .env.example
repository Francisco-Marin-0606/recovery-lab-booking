# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# GOOGLE_CLIENT_ID: Your Google OAuth Client ID
GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET: Your Google OAuth Client Secret
GOOGLE_CLIENT_SECRET=""
# GOOGLE_REDIRECT_URI: Your Google OAuth Redirect URI (optional, defaults to APP_URL/auth/google/callback)
GOOGLE_REDIRECT_URI=""

# GMAIL_USER: Gmail address used to send booking confirmation emails
GMAIL_USER="juanisasti7@gmail.com"
# GMAIL_APP_PASSWORD: App Password from Google (16 characters, requires 2FA enabled)
# Generate at: https://myaccount.google.com/apppasswords
GMAIL_APP_PASSWORD=""
